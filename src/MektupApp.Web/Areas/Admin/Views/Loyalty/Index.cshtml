@model MektupApp.Web.Areas.Admin.Controllers.LoyaltySettingsForm
@using MektupApp.Domain.Loyalty
@{
    ViewData["Title"] = "MektupPuan";
    var inv = System.Globalization.CultureInfo.InvariantCulture;

    // İki bölüm aynı yapıda: (alan öneki, başlık, açık mı, tür, değer, kapalıyken açıklama, örnek cümlesindeki kazanan)
    var sections = new[]
    {
        (Prefix: "", Title: "Gönderenin kazancı", Enabled: Model.IsEnabled, Type: Model.RewardType, Value: Model.Value,
         Off: "Kapalı: yeni siparişler gönderene puan kazandırmaz. Mevcut puanlar kullanılmaya devam eder.",
         Who: "mektubu gönderen üye"),
        (Prefix: "Referral", Title: "Referans kazancı", Enabled: Model.ReferralEnabled, Type: Model.ReferralRewardType, Value: Model.ReferralValue,
         Off: "Kapalı: davet edilen üyelerin mektupları, davet edene puan kazandırmaz.",
         Who: "onu davet eden üye")
    };
}

<h1 class="h4 mb-1">MektupPuan Ayarları</h1>
<p class="text-muted small mb-3">
    Puan, mektup postaya verildiğinde hesaba geçer ve sonraki ödemelerde aşağıdaki "puan değeri"ne göre TL'ye çevrilerek kullanılır.
    Kazanılacak puan ödeme anındaki ayara göre sabitlenir, sonradan yapılan değişiklik ödenmiş siparişleri etkilemez.
    @if (Model.UpdatedAt is { } at && Model.UpdatedBy is not null)
    {
        <br />@:Son güncelleme: @at.ToLocalTime().ToString("dd.MM.yyyy HH:mm") · @Model.UpdatedBy
    }
</p>

<form asp-action="Index" method="post" style="max-width: 640px" id="loyaltyForm">
    <div asp-validation-summary="All" class="text-danger small"></div>

    <section class="admin-card p-3 mb-3">
        <h2 class="h6">Puan değeri</h2>
        <p class="small text-muted mb-2">Müşteri ödeme yaparken puanı bu orana göre TL indirim olarak kullanır.</p>
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <label for="PointValue" class="mb-0">1 puan =</label>
            <div class="input-group input-group-sm" style="max-width: 180px">
                <input class="form-control text-end" type="number" step="0.01" min="0.01" max="1000" id="PointValue" name="PointValue"
                       value="@Model.PointValue.ToString("0.####", inv)" required />
                <span class="input-group-text">₺</span>
            </div>
        </div>
        <div class="alert alert-light border small mt-2 mb-0" id="pointValuePreview" aria-live="polite"></div>
        <div class="form-text">Bu değeri değiştirmek, müşterilerin mevcut puan bakiyelerinin TL karşılığını da değiştirir.</div>
    </section>

    @foreach (var s in sections)
    {
        var p = s.Prefix;
        <section class="admin-card p-3 mb-3 reward-section" data-prefix="@p" data-off="@s.Off" data-who="@s.Who">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h2 class="h6 mb-0">@s.Title</h2>
                <div class="form-check form-switch mb-0">
                    <input class="form-check-input" type="checkbox" role="switch" id="@(p)Enabled" name="@(p == "" ? "IsEnabled" : p + "Enabled")"
                           value="true" @(s.Enabled ? "checked" : "") />
                    <input type="hidden" name="@(p == "" ? "IsEnabled" : p + "Enabled")" value="false" />
                    <label class="form-check-label" for="@(p)Enabled">Açık</label>
                </div>
            </div>
            @if (p == "Referral")
            {
                <p class="small text-muted">
                    Üye olurken "Bizi nereden duydunuz?" sorusunda <strong>Arkadaş</strong>'ı seçip bir referans no giren üyelerin
                    gönderdiği her mektup için, referans no'nun sahibi bu kurala göre puan kazanır.
                </p>
            }

            <fieldset class="mb-2">
                <legend class="form-label small mb-1">Kazanım türü</legend>
                @foreach (var t in Enum.GetValues<RewardType>())
                {
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="@(p)RewardType" id="@(p)rt-@t" value="@t" @(s.Type == t ? "checked" : "") />
                        <label class="form-check-label small" for="@(p)rt-@t">@t.DisplayName()</label>
                    </div>
                }
            </fieldset>

            <div class="mb-2" style="max-width: 260px">
                <label class="form-label small" for="@(p)Value">Değer</label>
                <div class="input-group input-group-sm">
                    <input class="form-control text-end" type="number" step="0.01" min="0" id="@(p)Value" name="@(p)Value"
                           value="@s.Value.ToString("0.##", inv)" required />
                    <span class="input-group-text unit">@(s.Type == RewardType.Percentage ? "%" : "puan")</span>
                </div>
            </div>

            <div class="alert alert-light border small mb-0 preview" aria-live="polite"></div>
        </section>
    }

    <button type="submit" class="btn btn-primary">Kaydet</button>
</form>

@section Scripts {
    <script>
        (function () {
            const fmt = v => v.toLocaleString("tr-TR", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            const pointValue = () => parseFloat(document.getElementById("PointValue").value) || 0;
            const money = points => fmt(Math.round(points * pointValue() * 100) / 100) + " ₺";

            function renderPointValue() {
                const v = pointValue();
                document.getElementById("pointValuePreview").innerHTML = v > 0
                    ? "Örnek: 100 puan = <strong>" + money(100) + "</strong> indirim. 290,00 ₺'lik bir mektubu tamamen puanla ödemek için <strong>" +
                      fmt(Math.ceil(290 / v * 100) / 100) + " puan</strong> gerekir."
                    : "Geçerli bir değer girin.";
                document.querySelectorAll(".reward-section").forEach(render);
            }
            document.getElementById("PointValue").addEventListener("input", renderPointValue);

            function render(section) {
                const p = section.dataset.prefix;
                const enabled = document.getElementById(p + "Enabled").checked;
                const pct = section.querySelector(`input[name=${p}RewardType]:checked`)?.value === "Percentage";
                const v = parseFloat(document.getElementById(p + "Value").value) || 0;
                section.querySelector(".unit").textContent = pct ? "%" : "puan";
                const preview = section.querySelector(".preview");
                if (!enabled) { preview.textContent = section.dataset.off; return; }
                const points = pct ? Math.round(290 * v) / 100 : v;
                preview.innerHTML = "Örnek: 290,00 ₺ ödenen bir mektup için " + section.dataset.who + " <strong>" +
                    fmt(points) + " puan</strong> kazanır (= " + money(points) + " değerinde).";
            }
            document.querySelectorAll(".reward-section").forEach(section => {
                section.addEventListener("input", () => render(section));
                section.addEventListener("change", () => render(section));
            });
            renderPointValue();
        })();
    </script>
}
