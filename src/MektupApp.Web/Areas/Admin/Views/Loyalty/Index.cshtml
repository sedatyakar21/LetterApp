@model MektupApp.Web.Areas.Admin.Controllers.LoyaltySettingsForm
@using MektupApp.Domain.Loyalty
@{
    ViewData["Title"] = "MektupPuan";
    var inv = System.Globalization.CultureInfo.InvariantCulture;
}

<h1 class="h4 mb-1">MektupPuan Ayarları</h1>
<p class="text-muted small mb-3">
    Müşteriler gönderdikleri her mektup postaya verildiğinde puan kazanır; 1 puan = 1 ₺ olarak sonraki ödemelerde kullanılır.
    Kazanılacak puan ödeme anındaki ayara göre sabitlenir, sonradan yapılan değişiklik ödenmiş siparişleri etkilemez.
    @if (Model.UpdatedAt is { } at && Model.UpdatedBy is not null)
    {
        <br />@:Son güncelleme: @at.ToLocalTime().ToString("dd.MM.yyyy HH:mm") · @Model.UpdatedBy
    }
</p>

<form asp-action="Index" method="post" class="admin-card p-3" style="max-width: 640px" id="loyaltyForm">
    <div asp-validation-summary="All" class="text-danger small"></div>

    <div class="form-check form-switch mb-3">
        <input class="form-check-input" type="checkbox" role="switch" id="IsEnabled" name="IsEnabled" value="true" @(Model.IsEnabled ? "checked" : "") />
        <input type="hidden" name="IsEnabled" value="false" />
        <label class="form-check-label fw-semibold" for="IsEnabled">Puan kazanımı açık</label>
    </div>

    <fieldset class="mb-3">
        <legend class="form-label fs-6">Kazanım türü</legend>
        @foreach (var t in Enum.GetValues<RewardType>())
        {
            <div class="form-check">
                <input class="form-check-input" type="radio" name="RewardType" id="rt-@t" value="@t" @(Model.RewardType == t ? "checked" : "") />
                <label class="form-check-label" for="rt-@t">@t.DisplayName()</label>
            </div>
        }
    </fieldset>

    <div class="mb-3" style="max-width: 260px">
        <label class="form-label" for="Value">Değer</label>
        <div class="input-group">
            <input class="form-control text-end" type="number" step="0.01" min="0" id="Value" name="Value"
                   value="@Model.Value.ToString("0.##", inv)" required />
            <span class="input-group-text" id="valueUnit">@(Model.RewardType == RewardType.Percentage ? "%" : "puan")</span>
        </div>
    </div>

    <div class="alert alert-light border small" id="preview" aria-live="polite"></div>

    <button type="submit" class="btn btn-primary">Kaydet</button>
</form>

@section Scripts {
    <script>
        (function () {
            const form = document.getElementById("loyaltyForm");
            const fmt = v => v.toLocaleString("tr-TR", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            function render() {
                const enabled = document.getElementById("IsEnabled").checked;
                const pct = form.querySelector("input[name=RewardType]:checked")?.value === "Percentage";
                const v = parseFloat(document.getElementById("Value").value) || 0;
                document.getElementById("valueUnit").textContent = pct ? "%" : "puan";
                const preview = document.getElementById("preview");
                if (!enabled) { preview.textContent = "Puan kazanımı kapalı: yeni siparişler puan kazandırmaz. Mevcut puanlar kullanılmaya devam eder."; return; }
                preview.innerHTML = "Örnek: 290,00 ₺ ödenen bir mektup için müşteri <strong>" +
                    fmt(pct ? Math.round(290 * v) / 100 : v) + " puan</strong> kazanır.";
            }
            form.addEventListener("input", render);
            form.addEventListener("change", render);
            render();
        })();
    </script>
}
