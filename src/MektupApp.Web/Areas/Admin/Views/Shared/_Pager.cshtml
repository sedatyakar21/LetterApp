@model PagerModel
@if (Model.TotalPages > 1)
{
    var from = Math.Max(1, Model.Page - 2);
    var to = Math.Min(Model.TotalPages, Model.Page + 2);
    <nav aria-label="Sayfalar" class="d-flex justify-content-between align-items-center mt-3">
        <span class="text-muted small">Toplam @Model.TotalCount kayıt</span>
        <ul class="pagination pagination-sm mb-0">
            <li class="page-item @(Model.Page <= 1 ? "disabled" : "")"><a class="page-link" href="@Model.UrlFor(Model.Page - 1)">‹</a></li>
            @for (var p = from; p <= to; p++)
            {
                <li class="page-item @(p == Model.Page ? "active" : "")"><a class="page-link" href="@Model.UrlFor(p)">@p</a></li>
            }
            <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")"><a class="page-link" href="@Model.UrlFor(Model.Page + 1)">›</a></li>
        </ul>
    </nav>
}
else
{
    <div class="text-muted small mt-2">Toplam @Model.TotalCount kayıt</div>
}
