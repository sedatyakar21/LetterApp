@model MektupApp.Web.Areas.Admin.Controllers.LegalDocumentForm
@{
    var isNew = Model.Id is null;
    ViewData["Title"] = isNew ? "Yeni Belge" : Model.Title;
}

<a asp-action="Index" class="small">← Sözleşmeler</a>
<div class="d-flex flex-wrap align-items-center gap-2 mt-1 mb-3">
    <h1 class="h4 mb-0">@(isNew ? "Yeni Belge" : "Belgeyi Düzenle")</h1>
    @if (!isNew)
    {
        <span class="badge @(Model.IsPublished ? "bg-success" : "bg-secondary")">@(Model.IsPublished ? "Yayında" : "Taslak")</span>
        <span class="badge bg-light text-dark border">v@(Model.Version)</span>
        @if (Model.IsSystem) { <span class="badge bg-light text-dark border" title="Sitede bağlantısı var">🔒 sistem belgesi</span> }
    }
</div>

<div class="row g-3">
    <div class="col-xl-8">
        <form asp-action="@(isNew ? "Create" : "Edit")" asp-route-id="@Model.Id" method="post" class="admin-card p-3" id="docForm">
            <div asp-validation-summary="All" class="text-danger small"></div>

            <div class="mb-3">
                <label asp-for="Title" class="form-label"></label>
                <input asp-for="Title" class="form-control form-control-lg" placeholder="ör. Mesafeli Satış Sözleşmesi" />
            </div>
            <div class="mb-3">
                <label asp-for="Slug" class="form-label"></label>
                <div class="input-group">
                    <span class="input-group-text small">/sozlesme/</span>
                    <input asp-for="Slug" class="form-control font-monospace" placeholder="boş bırakılırsa başlıktan üretilir"
                           readonly="@Model.IsSystem" />
                </div>
                @if (Model.IsSystem)
                {
                    <div class="form-text">Bu belgenin adresi sitede ve uygulamada kullanıldığı için sabittir.</div>
                }
            </div>

            <div class="mb-2 d-flex justify-content-between align-items-end">
                <label asp-for="ContentMarkdown" class="form-label mb-0"></label>
                <ul class="nav nav-pills small" role="tablist">
                    <li class="nav-item"><button type="button" class="nav-link py-1 active" data-tab="write">Yaz</button></li>
                    <li class="nav-item"><button type="button" class="nav-link py-1" data-tab="preview">Önizleme</button></li>
                </ul>
            </div>
            <textarea asp-for="ContentMarkdown" class="form-control font-monospace" rows="22" id="contentInput"
                      placeholder="## 1. Taraflar&#10;&#10;**Satıcı:** ...&#10;&#10;## 2. Konu&#10;&#10;- madde&#10;- madde"></textarea>
            <div class="blog-content admin-card p-3" id="contentPreview" hidden style="min-height: 300px"></div>
            <details class="small text-muted mt-2">
                <summary>Markdown yardımı</summary>
                <code>## Başlık</code> · <code>### Alt başlık</code> · <code>**kalın**</code> · <code>*italik*</code> ·
                <code>[metin](https://adres)</code> · <code>- madde</code> · <code>1. sıralı</code> · <code>&gt; not</code>.
                Word'den kopyaladığınız metni düz metin olarak yapıştırıp başlıklara <code>##</code> ekleyebilirsiniz.
                Güvenlik için HTML etiketleri kabul edilmez.
            </details>

            <div class="row g-3 mt-1">
                <div class="col-sm-6">
                    <div class="form-check form-switch mt-sm-4">
                        <input asp-for="ShowInFooter" class="form-check-input" type="checkbox" role="switch" />
                        <label asp-for="ShowInFooter" class="form-check-label"></label>
                    </div>
                </div>
                <div class="col-sm-3">
                    <label asp-for="SortOrder" class="form-label small"></label>
                    <input asp-for="SortOrder" class="form-control" type="number" min="0" max="999" />
                </div>
            </div>

            <div class="d-flex flex-wrap gap-2 mt-3">
                <button type="submit" class="btn btn-outline-secondary">@(Model.IsPublished ? "Kaydet" : "Taslak Olarak Kaydet")</button>
                @if (!Model.IsPublished)
                {
                    <button type="submit" name="publish" value="true" class="btn btn-primary">Kaydet ve Yayınla</button>
                }
            </div>
        </form>
    </div>

    @if (!isNew)
    {
        <div class="col-xl-4">
            <div class="admin-card p-3 mb-3">
                <div class="fw-semibold mb-2">Yayın</div>
                <div class="small text-muted mb-2">
                    @(Model.IsPublished ? "Sitede yayında." : "Taslak — ziyaretçiler göremez.")
                    @if (Model.UpdatedAt is { } at)
                    {
                        <br /><span>Son güncelleme: @at.ToLocalTime().ToString("dd.MM.yyyy HH:mm") · @Model.UpdatedBy</span>
                    }
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <a class="btn btn-sm btn-outline-secondary" target="_blank"
                       href="@Url.Action("Show", "Legal", new { area = "", slug = Model.Slug, onizleme = Model.IsPublished ? (bool?)null : true })">
                        @(Model.IsPublished ? "Sayfayı görüntüle ↗" : "Önizle ↗")
                    </a>
                    @if (Model.IsPublished)
                    {
                        <form asp-action="Unpublish" asp-route-id="@Model.Id" method="post"
                              onsubmit="return confirm('@(Model.IsSystem ? "Bu belgenin sitede bağlantısı var; yayından kalkınca bağlantı \"bulunamadı\" sayfasına gider. " : "")Yayından kaldırılsın mı?')">
                            <button class="btn btn-sm btn-outline-warning">Yayından Kaldır</button>
                        </form>
                    }
                    else
                    {
                        <form asp-action="Publish" asp-route-id="@Model.Id" method="post">
                            <button class="btn btn-sm btn-success">Yayınla</button>
                        </form>
                    }
                </div>
            </div>

            @if (!Model.IsSystem)
            {
                <div class="admin-card p-3 border-danger-subtle">
                    <form asp-action="Delete" asp-route-id="@Model.Id" method="post"
                          onsubmit="return confirm('Bu belge kalıcı olarak silinecek. Emin misiniz?')">
                        <button class="btn btn-sm btn-outline-danger">Belgeyi Sil</button>
                    </form>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
    <script>
        // Yaz / Önizleme: önizleme sitedeki aynı güvenli Markdown dönüştürücüsüyle üretilir.
        (function () {
            const input = document.getElementById("contentInput");
            const preview = document.getElementById("contentPreview");
            const token = document.querySelector("#docForm input[name=__RequestVerificationToken]").value;
            document.querySelectorAll("[data-tab]").forEach(btn => btn.addEventListener("click", async () => {
                document.querySelectorAll("[data-tab]").forEach(b => b.classList.toggle("active", b === btn));
                const showPreview = btn.dataset.tab === "preview";
                input.hidden = showPreview;
                preview.hidden = !showPreview;
                if (!showPreview) return;
                preview.innerHTML = "<p class='text-muted'>Önizleme hazırlanıyor…</p>";
                const body = new FormData();
                body.append("markdown", input.value);
                body.append("__RequestVerificationToken", token);
                const res = await fetch("@Url.Action("Preview")", { method: "POST", body });
                preview.innerHTML = res.ok ? await res.text() : "<p class='text-danger'>Önizleme alınamadı.</p>";
            }));
        })();
    </script>
}
