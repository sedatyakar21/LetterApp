@model WeightFormViewModel
@{
    ViewData["Title"] = "Ağırlıklar";
    var fields = new[]
    {
        nameof(Model.LetterSheet), nameof(Model.Photo), nameof(Model.Postcard), nameof(Model.DocumentSheet), nameof(Model.Envelope)
    };
    var inv = System.Globalization.CultureInfo.InvariantCulture;
}

<h1 class="h4 mb-1">Ağırlıklar</h1>
<p class="text-muted small mb-3">
    Zarf çıktısına basılan <strong>tahmini ağırlık</strong> ve PTT'ye bildirilen ağırlık bu birim değerlerden hesaplanır:
    zarf + mektup yaprakları + fotoğraflar + kartpostal + belge yaprakları (PDF'in her sayfası bir yaprak). Sonuç yukarı yuvarlanır.
    @if (Model.UpdatedAt is { } at)
    {
        <br />@:Son güncelleme: @at.ToLocalTime().ToString("dd.MM.yyyy HH:mm") · @Model.UpdatedBy
    }
    else
    {
        <br />@:Henüz kaydedilmedi; varsayılan değerler kullanılıyor.
    }
</p>

<form asp-action="Index" method="post" class="admin-card p-3" style="max-width: 640px">
    <div asp-validation-summary="All" class="text-danger small"></div>

    @foreach (var f in fields)
    {
        <div class="row g-2 align-items-center mb-2">
            <label class="col-sm-7 col-form-label" for="@f">@Html.DisplayName(f)</label>
            <div class="col-sm-5">
                <div class="input-group">
                    <input class="form-control text-end" id="@f" name="@f" type="number" step="0.1" min="0" max="1000"
                           value="@(((decimal)typeof(WeightFormViewModel).GetProperty(f)!.GetValue(Model)!).ToString("0.##", inv))" required />
                    <span class="input-group-text">g</span>
                </div>
            </div>
        </div>
    }

    <div class="small text-muted mb-3">
        Örnek: 80 g/m² A4 kağıt ≈ 5 g; 13×18 cm zarf ≈ 5–7 g. En doğrusu, birkaç yaprağı birlikte tartıp adede bölmektir.
    </div>

    <button type="submit" class="btn btn-primary">Kaydet</button>
</form>
