@model PricingFormViewModel
@{
    ViewData["Title"] = "Fiyatlar";
    var fields = new[]
    {
        nameof(Model.BasePrice), nameof(Model.ExtraPage), nameof(Model.Photo), nameof(Model.Postcard),
        nameof(Model.ColoredPaper), nameof(Model.ColoredEnvelope), nameof(Model.Scent)
    };
}

<h1 class="h4 mb-1">Fiyatlar</h1>
<p class="text-muted small mb-3">
    Değişiklikler yalnızca bundan sonra yapılacak ödemelere uygulanır; ödenmiş siparişlerin tutarı değişmez.
    @if (Model.UpdatedAt is { } at)
    {
        <br />@:Son güncelleme: @at.ToLocalTime().ToString("dd.MM.yyyy HH:mm") · @Model.UpdatedBy
    }
</p>

<form asp-action="Index" method="post" class="admin-card p-3" style="max-width: 640px">
    <div asp-validation-summary="All" class="text-danger small"></div>

    @foreach (var f in fields)
    {
        <div class="row g-2 align-items-center mb-2">
            <label class="col-sm-7 col-form-label" for="@f">@Html.DisplayName(f)</label>
            <div class="col-sm-5">
                <div class="input-group">
                    <input class="form-control text-end" id="@f" name="@f" type="number" step="0.01" min="0"
                           value="@(((decimal)typeof(PricingFormViewModel).GetProperty(f)!.GetValue(Model)!).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))" required />
                    <span class="input-group-text">₺</span>
                </div>
            </div>
        </div>
    }

    <div class="row g-2 align-items-center mb-3">
        <label asp-for="MobileSurchargePercent" class="col-sm-7 col-form-label"></label>
        <div class="col-sm-5">
            <div class="input-group">
                <input class="form-control text-end" id="MobileSurchargePercent" name="MobileSurchargePercent" type="number" step="0.1" min="0" max="100"
                       value="@Model.MobileSurchargePercent.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" required />
                <span class="input-group-text">%</span>
            </div>
        </div>
    </div>

    <button type="submit" class="btn btn-primary">Kaydet</button>
</form>
