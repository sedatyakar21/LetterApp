@model IReadOnlyList<MektupApp.Application.Blog.BlogPostSummaryDto>
@using MektupApp.Domain.Blog
@{
    ViewData["Title"] = "Blog";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h4 mb-0">Blog Yazıları</h1>
    <div class="d-flex gap-2">
        <a class="btn btn-sm btn-outline-secondary" asp-area="" asp-controller="Blog" asp-action="Index" target="_blank">Blogu görüntüle ↗</a>
        <a class="btn btn-sm btn-primary" asp-action="Create">+ Yeni Yazı</a>
    </div>
</div>

<div class="admin-card overflow-hidden">
    <div class="table-responsive">
        <table class="table table-admin table-hover">
            <thead>
                <tr><th>Başlık</th><th>Durum</th><th>Yazar</th><th>Yayın</th><th>Güncelleme</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td>
                            <a asp-action="Edit" asp-route-id="@p.Id" class="fw-semibold">@p.Title</a>
                            <div class="small text-muted font-monospace">/blog/@p.Slug</div>
                        </td>
                        <td>
                            <span class="badge @(p.Status == BlogPostStatus.Published ? "bg-success" : "bg-secondary")">@p.Status.DisplayName()</span>
                            @if (!p.HasCover) { <span class="badge bg-light text-muted border" title="Kapak görseli yok">kapaksız</span> }
                        </td>
                        <td class="small">@p.AuthorName</td>
                        <td class="small">@(p.PublishedAt?.ToLocalTime().ToString("dd.MM.yyyy") ?? "—")</td>
                        <td class="small text-muted">@p.UpdatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-secondary" target="_blank"
                               href="@Url.Action("Post", "Blog", new { area = "", slug = p.Slug, onizleme = p.Status == BlogPostStatus.Published ? (bool?)null : true })">Görüntüle</a>
                        </td>
                    </tr>
                }
                @if (Model.Count == 0)
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">Henüz yazı yok. <a asp-action="Create">İlk yazını ekle</a>.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
