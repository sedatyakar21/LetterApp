@model IReadOnlyList<LetterDetailsDto>
@{
    // Baskıya özel sayfa: yönetim menüsü olmadan, A4 sayfalar halinde.
    Layout = null;
    var single = Model.Count == 1;
    var title = single ? $"Yazdır — {Model[0].RecipientName}" : $"Yazdır — {Model.Count} sipariş";
    string OrderNo(LetterDetailsDto l) => "#" + OrderNumber.Format(l.Id);
    var weights = (Dictionary<Guid, WeightEstimate>)ViewBag.Weights;
    string G(decimal grams) => grams.ToString("0.#", System.Globalization.CultureInfo.GetCultureInfo("tr-TR")) + " g";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <title>@title | BiMektubum Yönetim</title>
    <link rel="icon" href="~/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Caveat:wght@500&family=Lora:ital,wght@0,400;0,600;0,700;1,400;1,600;1,700&display=swap">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/order-print.css" asp-append-version="true" />
</head>
<body class="print-body env-z1318">
    <div class="print-toolbar no-print">
        <div class="d-flex flex-wrap align-items-center gap-3">
            <a href="@(single ? Url.Action("Details", new { id = Model[0].Id }) : Url.Action("Index"))" class="small">← @(single ? "Sipariş" : "Siparişler")</a>
            <strong>@(single ? $"{Model[0].RecipientName} {OrderNo(Model[0])}" : $"{Model.Count} sipariş")</strong>
            <span class="ms-auto small" id="printStatus" role="status"></span>
        </div>
        @* Her düğme yalnızca o bölümü yazdırır; yazıcıya uygun kâğıdı (zarf, A4, fotoğraf kağıdı) koyup ilgili düğmeye basın. *@
        <div class="d-flex flex-wrap align-items-center gap-2 mt-2">
            <div class="btn-group" role="group" aria-label="Zarf">
                <button type="button" class="btn btn-sm btn-primary" data-print="label" disabled>📮 Zarf Yazdır</button>
                <select class="form-select form-select-sm w-auto rounded-start-0" id="envelopeSize" title="Zarf boyutu" aria-label="Zarf boyutu">
                    <option value="z1318">13×18 cm</option>
                    <option value="dl">DL · 220×110 mm</option>
                    <option value="c5">C5 · 229×162 mm</option>
                    <option value="c4">C4 · 324×229 mm</option>
                </select>
            </div>
            <button type="button" class="btn btn-sm btn-primary" data-print="letter" disabled>✉️ Mektup Yazdır</button>
            <button type="button" class="btn btn-sm btn-primary" data-print="photos" disabled
                    data-empty="@(Model.All(l => l.Photos.Count == 0) ? "true" : null)">📷 Fotoğrafları Yazdır</button>
            <button type="button" class="btn btn-sm btn-primary" data-print="documents" disabled
                    data-empty="@(Model.All(l => l.Documents.Count == 0) ? "true" : null)">📄 Belgeleri Yazdır</button>
            <button type="button" class="btn btn-sm btn-outline-secondary" data-print="all" disabled>🖨️ Tümünü Yazdır</button>
        </div>
        <div class="small text-muted mt-1">
            Zarf seçilen boyutta, fotoğraflar 10×15 cm fotoğraf kağıdına (kenarsız), mektup ve belgeler A4 basılır; her bölüm yeni sayfadan başlar.
            Renkli kâğıt seçilen mektuplarda arka plan basılmaz; yazıcıya o renkte kâğıt koyun.
        </div>
    </div>

    <main class="print-pages">
        @foreach (var l in Model)
        {
            var photoCount = l.Photos.Count;
            var docCount = l.Documents.Count;
            var weight = weights[l.Id];

            @* 1a. Zarflama kontrol listesi: yalnızca ekranda (zarfa basılmaz). *@
            <div class="envelope-checklist part-label no-print">
                <div class="d-flex justify-content-between align-items-baseline">
                    <strong>Sipariş @OrderNo(l) · @l.RecipientName</strong>
                    <span class="small text-muted">@(l.TrackingCode is { } tc ? $"Takip: {tc}" : l.Status.DisplayName())</span>
                </div>
                <div class="label-caption mt-1 mb-1">ZARFA KONACAKLAR</div>
                <ul class="checklist small">
                    <li>Mektup — @l.PageCount sayfa · @l.Style.Paper.DisplayName() kâğıt · @l.Style.Font.DisplayName() / @l.Style.Ink.DisplayName() / @l.Style.Size.DisplayName() yazı</li>
                    @if (photoCount > 0) { <li>Fotoğraf × @photoCount</li> }
                    @if (docCount > 0) { <li>Belge × @docCount: @string.Join(", ", l.Documents.Select(d => d.OriginalFileName))</li> }
                    @if (l.Postcards.Count > 0)
                    {
                        <li>Kartpostal × @l.Postcards.Count: <partial name="_PostcardList" model="l.Postcards" /></li>
                    }
                    @if (l.Scent is not null) { <li>Koku: @l.Scent.Name</li> }
                    <li>Zarf: @l.Style.Envelope.DisplayName()</li>
                </ul>
                <div class="small mt-1">
                    <strong>Tahmini ağırlık: @weight.RoundedGrams g</strong>
                    <span class="text-muted">(@string.Join(" + ", weight.Lines.Select(x => x.Count > 1 ? $"{x.Description} {x.Count}×{G(x.Grams / x.Count)}" : $"{x.Description} {G(x.Grams)}")))</span>
                    · <a asp-controller="Weights" asp-action="Index" target="_blank">birim ağırlıklar</a>
                </div>
            </div>

            @* 1b. Zarf çıktısı: sol üst aracı firma + gönderen, sağ alt alıcı, sol alt logo. Zarf boyutunda sayfa. *@
            <section class="sheet part-label envelope-sheet">
                <div class="env-from">
                    <div class="label-caption">GÖNDEREN</div>
                    <div class="fw-semibold">@l.SenderName</div>
                    <div>@l.SenderAddress.Line</div>
                    <div>@l.SenderAddress.District / @l.SenderAddress.City @l.SenderAddress.PostalCode</div>
                </div>
                <div class="env-to">
                    <div class="label-caption">ALICI</div>
                    <div class="env-to-name">@l.RecipientName</div>
                    @if (l.RecipientNote is not null) { <div>@l.RecipientNote</div> }
                    @if (l.RecipientDetail is not null) { <div>@l.RecipientDetail</div> }
                    <div>@l.RecipientAddress.Line</div>
                    <div class="fw-semibold">@l.RecipientAddress.District / @l.RecipientAddress.City @l.RecipientAddress.PostalCode</div>
                </div>
                @* Sağ üst: tahmini ağırlık, altında takip numarasının barkodu (Code 128) ve numara. *@
                <div class="env-weight">
                    <div>Tahmini ağırlık: <strong>@weight.RoundedGrams g</strong></div>
                    @if (l.TrackingCode is { } trackingCode)
                    {
                        <div class="env-barcode">@Html.Raw(Code128.Svg(trackingCode, 50, 11))</div>
                        <div class="env-tracking">@trackingCode</div>
                    }
                    else
                    {
                        <div class="env-no-tracking no-print">Takip no yok — mektup postaya verilince (PTT kaydı) oluşur.</div>
                    }
                </div>
                @* Sol alt: aracı firma yazısı ve hemen altında logo. *@
                <div class="env-brand">
                    <div class="envelope-intermediary">@EnvelopeText.Intermediary</div>
                    <img class="env-logo" src="~/img/bimektubum-logo.png" alt="BiMektubum" data-wait />
                </div>
            </section>

            @* 2. Mektup (uzunsa kendiliğinden birden çok sayfaya taşar) *@
            <section class="sheet part-letter">
                @* Mektubun ilk sayfasının üstü: solda gönderen, sağda alıcı. *@
                <div class="letter-head">
                    <div class="letter-head-from">
                        <div class="label-caption">GÖNDEREN</div>
                        <div class="fw-semibold">@l.SenderName</div>
                        <div>@l.SenderAddress.Line</div>
                        <div>@l.SenderAddress.District / @l.SenderAddress.City @l.SenderAddress.PostalCode</div>
                    </div>
                    <div class="letter-head-to">
                        <div class="label-caption">ALICI</div>
                        <div class="fw-semibold">@l.RecipientName</div>
                        @if (l.RecipientNote is not null) { <div>@l.RecipientNote</div> }
                        @if (l.RecipientDetail is not null) { <div>@l.RecipientDetail</div> }
                        <div>@l.RecipientAddress.Line</div>
                        <div>@l.RecipientAddress.District / @l.RecipientAddress.City @l.RecipientAddress.PostalCode</div>
                    </div>
                </div>
                @* Baskıda imza satırı yok; yerine her sayfanın altında ortada "[gönderen → alıcı]".
                   Uzun mektuplar order-print.js tarafından A4 sayfalara bölünür (başlık yalnızca ilk sayfada). *@
                <div class="letter-body">
                    <div class="paper paper-@l.Style.Paper font-@l.Style.Font ink-@l.Style.Ink tsize-@l.Style.Size">
                        <div class="paper-content">@l.Content</div>
                    </div>
                </div>
                <div class="letter-foot">[@l.SenderName → @l.RecipientName]</div>
            </section>

            @* 3. Fotoğraflar: her biri 10×15 cm fotoğraf kağıdına, kenarsız; yatay fotoğraf yatay sayfaya basılır. *@
            @foreach (var p in l.Photos)
            {
                <section class="sheet part-photos photo-sheet photo-portrait">
                    <img src="@Url.Action("Photo", "Letters", new { area = "", id = l.Id, photoId = p.Id })" alt="@p.OriginalFileName" data-wait />
                </section>
            }

            @* 4. Belgeler: görseller doğrudan; PDF'lerin her sayfası tarayıcıda görüntüye çevrilip eklenir *@
            @foreach (var d in l.Documents)
            {
                var url = Url.Action("Document", "Letters", new { area = "", id = l.Id, documentId = d.Id });
                if (d.IsPdf)
                {
                    <section class="sheet part-documents pdf-placeholder" data-pdf="@url" data-name="@d.OriginalFileName">
                        <div class="text-muted small">📄 @d.OriginalFileName hazırlanıyor…</div>
                    </section>
                }
                else
                {
                    <section class="sheet part-documents sheet-image">
                        <img src="@url" alt="@d.OriginalFileName" data-wait />
                    </section>
                }
            }
        }
    </main>

    <script src="~/lib/pdfjs/pdf.min.js"></script>
    <script>window.pdfWorkerSrc = "@Url.Content("~/lib/pdfjs/pdf.worker.min.js")";</script>
    <script src="~/js/order-print.js" asp-append-version="true"></script>
</body>
</html>
