@model MektupApp.Application.Blog.BlogPostDto
@using MektupApp.Domain.Blog
@{
    ViewData["Title"] = Model.Title;
    ViewData["Description"] = Model.Excerpt;
    ViewData["OgType"] = "article";
    if (Model.HasCover) { ViewData["OgImage"] = Url.Action("Cover", "Blog", new { id = Model.Id }, Context.Request.Scheme); }
    var tr = System.Globalization.CultureInfo.GetCultureInfo("tr-TR");
    var related = ViewBag.Related as IReadOnlyList<MektupApp.Application.Blog.BlogPostSummaryDto> ?? [];
    var comments = ViewBag.Comments as IReadOnlyList<MektupApp.Application.Reviews.BlogCommentDto> ?? [];
    var myPending = ViewBag.MyPending as IReadOnlyList<MektupApp.Application.Reviews.BlogCommentDto> ?? [];
}

@if (Model.Status != BlogPostStatus.Published)
{
    <div class="container mt-3">
        <div class="alert alert-warning mb-0">
            <strong>Önizleme:</strong> bu yazı henüz yayında değil, sadece yöneticiler görebilir.
            <a asp-area="Admin" asp-controller="Blog" asp-action="Edit" asp-route-id="@Model.Id">Düzenle</a>
        </div>
    </div>
}

<article class="blog-post">
    <header class="container text-center pt-5 pb-4" style="max-width: 820px">
        <a asp-action="Index" class="small">← Blog</a>
        <h1 class="mt-2 blog-post-title">@Model.Title</h1>
        <div class="blog-meta mt-2">
            @Model.AuthorName · @((Model.PublishedAt ?? Model.UpdatedAt).ToLocalTime().ToString("d MMMM yyyy", tr)) · @Model.ReadingMinutes dk okuma
        </div>
    </header>

    @if (Model.HasCover)
    {
        <div class="container" style="max-width: 960px">
            <img src="@Url.Action("Cover", "Blog", new { id = Model.Id })" alt="" class="blog-post-cover" />
        </div>
    }

    <div class="container py-4" style="max-width: 760px">
        <p class="lead blog-lead">@Model.Excerpt</p>
        <div class="blog-content">
            @MarkdownRenderer.ToHtml(Model.ContentMarkdown)
        </div>

        <aside class="blog-cta mt-5" data-reveal>
            <div>
                <div class="fw-semibold">Siz de bir mektup yazın 💌</div>
                <div class="small text-muted">Klavyeden yazın, biz basıp zarflayalım ve kayıtlı posta ile gönderelim.</div>
            </div>
            <a class="btn btn-primary" asp-controller="Letters" asp-action="Write">Mektup Yaz</a>
        </aside>

        @if (Model.Status == BlogPostStatus.Published)
        {
            <section class="blog-comments mt-5" id="yorumlar" aria-labelledby="commentsTitle">
                <h2 class="h5 mb-3" id="commentsTitle">💬 Yorumlar (@comments.Count)</h2>

                @foreach (var c in comments.Concat(myPending))
                {
                    var pending = c.Status != MektupApp.Domain.Reviews.ModerationStatus.Approved;
                    <div class="blog-comment @(pending ? "is-pending" : "")">
                        <span class="review-avatar" aria-hidden="true">@c.AuthorName[..1]</span>
                        <div>
                            <div class="small">
                                <strong>@c.AuthorName</strong>
                                <span class="text-muted">· @c.CreatedAt.ToLocalTime().ToString("d MMMM yyyy", tr)</span>
                                @if (pending) { <span class="badge bg-warning text-dark ms-1">Onay bekliyor · sadece siz görüyorsunuz</span> }
                            </div>
                            <p class="mb-0 mt-1 blog-comment-body">@c.Body</p>
                        </div>
                    </div>
                }
                @if (comments.Count == 0 && myPending.Count == 0)
                {
                    <p class="text-muted small">Henüz yorum yok. İlk yorumu siz yazın.</p>
                }

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <form asp-action="Comment" asp-route-slug="@Model.Slug" method="post" class="mt-3">
                        <label for="commentBody" class="form-label small fw-semibold">Yorumunuz</label>
                        <textarea id="commentBody" name="body" class="form-control" rows="3" required
                                  maxlength="@MektupApp.Domain.Reviews.BlogComment.BodyMax" placeholder="Düşüncelerinizi paylaşın…"></textarea>
                        <div class="d-flex justify-content-between align-items-center mt-2">
                            <span class="form-text m-0">Yorumlar onaydan sonra adınız ve soyadınızın baş harfiyle yayınlanır.</span>
                            <button type="submit" class="btn btn-primary btn-sm">Gönder</button>
                        </div>
                    </form>
                }
                else
                {
                    <p class="small mt-3">Yorum yazmak için <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@(Context.Request.Path + "#yorumlar")">giriş yapın</a> veya <a asp-controller="Account" asp-action="Register">üye olun</a>.</p>
                }
            </section>
        }
    </div>
</article>

@if (related.Count > 0)
{
    <section class="features-band">
        <div class="container py-5">
            <h2 class="h4 section-title mb-4" data-reveal>Diğer yazılar</h2>
            <div class="row g-4" data-reveal-group="90">
                @foreach (var p in related)
                {
                    <div class="col-md-4" data-reveal><partial name="_PostCard" model="p" /></div>
                }
            </div>
        </div>
    </section>
}
