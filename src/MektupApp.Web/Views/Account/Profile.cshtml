@model MektupApp.Application.Customers.AccountDto
@inject MektupApp.Web.Infrastructure.GoogleSignIn Google
@{
    ViewData["Title"] = "Hesabım";
    var inv = System.Globalization.CultureInfo.InvariantCulture;
}
<div class="container py-4" style="max-width: 560px">
    <h1 class="h3 mb-4">Hesabım</h1>

    <div class="card mb-3">
        <ul class="list-group list-group-flush">
            <li class="list-group-item"><span class="text-muted small d-block">Ad Soyad</span>@Model.FullName</li>
            <li class="list-group-item"><span class="text-muted small d-block">E-posta</span>@Model.Email</li>
            <li class="list-group-item"><span class="text-muted small d-block">Cep Telefonu</span>@Model.Phone</li>
            <li class="list-group-item"><span class="text-muted small d-block">Üyelik tarihi</span>@Model.MemberSince.ToString("d MMMM yyyy")</li>
            <li class="list-group-item"><span class="text-muted small d-block">Referans no</span><span class="font-monospace">@Model.ReferralCode</span></li>
        </ul>
    </div>

    @if (Google.Available || Model.GoogleLinked)
    {
        <div class="card mb-3">
            <div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div>
                    <h2 class="h6 mb-1">Google ile giriş</h2>
                    <div class="small text-muted">
                        @if (Model.GoogleLinked)
                        {
                            @:✔️ Google hesabınız bağlı. Google ile tek tıkla giriş yapabilirsiniz.
                        }
                        else
                        {
                            @:Google hesabınızı bağlayın, şifre yazmadan giriş yapın.
                        }
                    </div>
                </div>
                @if (!Model.GoogleLinked)
                {
                    <form asp-controller="GoogleAuth" asp-action="Start" asp-route-baglan="true" method="post">
                        <button type="submit" class="btn btn-sm btn-google">Google'ı Bağla</button>
                    </form>
                }
                else if (Model.HasPassword)
                {
                    <form asp-action="UnlinkGoogle" method="post" onsubmit="return confirm('Google bağlantısı kaldırılacak; giriş için şifrenizi kullanacaksınız. Emin misiniz?')">
                        <button type="submit" class="btn btn-sm btn-outline-secondary">Bağlantıyı Kaldır</button>
                    </form>
                }
                else
                {
                    <span class="badge bg-light text-dark border">Hesap Google ile oluşturuldu</span>
                }
            </div>
        </div>
    }

    <div class="card">
        <div class="card-body">
            <h2 class="h6 mb-2">🎂 Doğum tarihi</h2>
            @if (Model.BirthDate is { } birth)
            {
                <p class="mb-1">@birth.ToString("d MMMM yyyy")</p>
                <p class="small text-muted mb-0">Doğum günü kampanyaları size otomatik uygulanır. Tarih hatalıysa destek ekibimize yazın.</p>
            }
            else
            {
                <p class="small text-muted">Doğum tarihinizi ekleyin; doğum gününüze özel kampanyalar ödeme ekranında otomatik uygulansın.
                    <strong>Bir kez girildikten sonra değiştirilemez.</strong></p>
                <form asp-action="BirthDate" method="post" class="d-flex gap-2">
                    <input type="date" name="birthDate" class="form-control" required autocomplete="bday"
                           max="@DateTime.Today.ToString("yyyy-MM-dd", inv)" />
                    <button type="submit" class="btn btn-primary flex-shrink-0"
                            onclick="return confirm('Doğum tarihiniz kaydedildikten sonra değiştirilemez. Onaylıyor musunuz?')">Kaydet</button>
                </form>
            }
        </div>
    </div>
</div>
