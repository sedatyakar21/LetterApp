@model LetterStatus
@{
    var css = Model switch
    {
        LetterStatus.Draft => "bg-secondary",
        LetterStatus.AwaitingPayment => "bg-light text-dark border",
        LetterStatus.Paid => "badge-soft-navy",
        LetterStatus.InProduction => "bg-warning text-dark",
        LetterStatus.Shipped => "badge-navy",
        LetterStatus.Delivered => "bg-success",
        _ => "bg-dark"
    };
}
<span class="badge @css">@Model.DisplayName()</span>
