@* Görünüm (açık / koyu): sayfa çizilmeden önce uygulanır ki açık tema bir an görünüp kaybolmasın.
   Seçim tarayıcıda saklanır ("bm-theme": system | light | dark); "system" cihazın ayarını izler. *@
<script>
    (function () {
        var root = document.documentElement, media = window.matchMedia("(prefers-color-scheme: dark)");
        function pref() { try { return localStorage.getItem("bm-theme") || "system"; } catch (e) { return "system"; } }
        function apply(p) {
            var dark = p === "dark" || (p === "system" && media.matches);
            root.setAttribute("data-bs-theme", dark ? "dark" : "light");
            var meta = document.querySelector('meta[name="theme-color"]');
            if (meta) meta.setAttribute("content", dark ? "#13151C" : "#26304E");
        }
        window.bmTheme = {
            get: pref,
            set: function (p) { try { localStorage.setItem("bm-theme", p); } catch (e) { } apply(p); }
        };
        apply(pref());
        media.addEventListener && media.addEventListener("change", function () { if (pref() === "system") apply("system"); });
        document.addEventListener("DOMContentLoaded", function () { apply(pref()); });
    })();
</script>
