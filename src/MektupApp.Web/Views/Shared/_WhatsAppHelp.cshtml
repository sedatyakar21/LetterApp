@using Microsoft.Extensions.Options
@inject IOptions<SupportOptions> SupportOptionsAccessor
@{
    var support = SupportOptionsAccessor.Value;
    if (!support.WhatsAppEnabled) { return; }

    // Mesajlar müşterinin kendi WhatsApp'ından gönderilir; biz sadece taslağı hazırlarız.
    var name = User.Identity?.IsAuthenticated == true ? User.Identity.Name : null;
    var orderRef = ViewData["SupportOrderRef"] as string; // mektup detay sayfası doldurur
    string Msg(string text)
    {
        var lines = new List<string> { "Merhaba BiMektup, " + text };
        if (orderRef is not null) lines.Add($"Sipariş: {orderRef}");
        if (name is not null) lines.Add($"Ad Soyad: {name}");
        return string.Join("\n", lines);
    }

    var topics = new (string Icon, string Title, string Message)[]
    {
        ("📦", "Siparişimi takip etmek istiyorum", Msg("mektubumun durumunu öğrenmek istiyorum.")),
        ("💳", "Ödeme ile ilgili sorun", Msg("ödeme sırasında bir sorun yaşadım.")),
        ("🏠", "Alıcı adresini değiştirmek istiyorum", Msg("mektubumun alıcı adresini değiştirmek istiyorum.")),
        ("✍️", "Mektup yazarken yardım", Msg("mektup yazarken yardıma ihtiyacım var.")),
        ("🎁", "MektupPuan / referans", Msg("MektupPuan veya referans kodumla ilgili bir sorum var.")),
        ("💬", "Başka bir konu", Msg(""))
    };
}

<div class="wa-help" id="waHelp">
    <div class="wa-panel" id="waPanel" role="dialog" aria-modal="false" aria-labelledby="waTitle" hidden>
        <div class="wa-panel-head">
            <div class="wa-avatar" aria-hidden="true"><img src="~/favicon.svg" alt="" width="36" height="36" /></div>
            <div class="min-w-0">
                <div class="fw-semibold" id="waTitle">BiMektup Destek</div>
                <div class="small opacity-75">@(support.Hours ?? "Genellikle birkaç dakika içinde yanıt verir")</div>
            </div>
            <button type="button" class="wa-close" id="waClose" aria-label="Yardım menüsünü kapat">×</button>
        </div>
        <div class="wa-panel-body">
            <div class="wa-bubble">Merhaba 👋 Size nasıl yardımcı olabiliriz? Bir konu seçin, WhatsApp'ta mesajınız hazır gelsin.</div>
            <ul class="wa-topics">
                @foreach (var t in topics)
                {
                    <li>
                        <a href="@support.WhatsAppLink(t.Message)" target="_blank" rel="noopener">
                            <span class="wa-topic-icon" aria-hidden="true">@t.Icon</span>
                            <span>@t.Title</span>
                            <span class="wa-topic-arrow" aria-hidden="true">›</span>
                        </a>
                    </li>
                }
            </ul>
        </div>
        <div class="wa-panel-foot small">
            @if (support.WhatsAppDisplay is not null) { <span>WhatsApp: @support.WhatsAppDisplay</span> }
            @if (support.Email is not null) { <span>· <a href="mailto:@support.Email">@support.Email</a></span> }
            <span>· <a asp-area="" asp-controller="Home" asp-action="Faq">S.S.S.</a></span>
        </div>
    </div>

    <button type="button" class="wa-fab" id="waToggle" aria-controls="waPanel" aria-expanded="false" aria-label="WhatsApp yardım menüsünü aç">
        <svg viewBox="0 0 32 32" width="28" height="28" aria-hidden="true">
            <path fill="currentColor" d="M16 3C8.8 3 3 8.6 3 15.6c0 2.5.8 4.9 2.1 6.9L3.6 29l6.7-1.7c1.8 1 3.8 1.5 5.8 1.5 7.2 0 13-5.6 13-12.6S23.2 3 16 3zm0 23.4c-1.9 0-3.7-.5-5.3-1.4l-.4-.2-4 1 1-3.8-.3-.4c-1.1-1.7-1.6-3.6-1.6-5.5C5.4 9.9 10.1 5.4 16 5.4s10.6 4.5 10.6 10.2S21.9 26.4 16 26.4zm5.8-7.6c-.3-.2-1.9-.9-2.2-1s-.5-.2-.7.2-.8 1-1 1.2-.4.2-.7.1c-.3-.2-1.4-.5-2.6-1.6-1-.8-1.6-1.9-1.8-2.2s0-.5.1-.6l.5-.6c.2-.2.2-.4.3-.6s0-.4 0-.6l-1-2.4c-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.6.1-.9.4s-1.2 1.1-1.2 2.7 1.2 3.1 1.4 3.4c.2.2 2.4 3.6 5.8 5 .8.3 1.5.5 2 .7.8.3 1.6.2 2.2.1.7-.1 1.9-.8 2.2-1.5s.3-1.3.2-1.5c-.1-.1-.3-.2-.6-.3z"/>
        </svg>
        <span class="wa-fab-label">Yardım</span>
    </button>
</div>
