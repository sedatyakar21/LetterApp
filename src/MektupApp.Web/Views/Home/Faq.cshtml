@model PriceList
@using MektupApp.Domain.Common
@{
    ViewData["Title"] = "Sıkça Sorulan Sorular";
    Money M(decimal v) => new(v);
    var faqs = new (string Q, string A)[]
    {
        ("BiMektup nedir?", "Online olarak yazdığınız mektubu basıp zarflayan ve kayıtlı posta ile alıcıya ulaştıran bir hizmettir."),
        ("Üyelik ücretli mi?", "Hayır. Üyelik ve abonelik ücreti yoktur; sadece gönderdiğiniz mektup için ödeme yaparsınız."),
        ("Askere veya cezaevine mektup gönderebilir miyim?", "Evet. Alıcı türünü seçtiğinizde birlik ya da kurum/koğuş bilgisini girmeniz istenir; bu bilgi zarfa basılır."),
        ("Mektubumu yarım bırakabilir miyim?", "Evet. Taslak olarak kaydedip daha sonra kaldığınız yerden devam edebilirsiniz."),
        ("Adresi yanlış girdim, ne yapmalıyım?", "Mektubunuz kargoya verilene kadar 'Mektuplarım' sayfasından alıcı adresini değiştirebilirsiniz."),
        ("Siparişimi iptal edebilir miyim?", "Ödemesi alınmış ancak henüz basıma alınmamış mektuplar iptal edilebilir; ücret iade edilir."),
        ("Mektubumu nasıl takip ederim?", "Mektubunuz postaya verildiğinde takip kodu SMS ile gönderilir. 'Gönderi Takibi' sayfasından durumunu görebilirsiniz.")
    };
}

<div class="container py-4" style="max-width: 860px">
    <h1 class="h3 mb-4">Sıkça Sorulan Sorular</h1>

    <div class="accordion mb-5" id="faq" data-reveal-group="70">
        @for (var i = 0; i < faqs.Length; i++)
        {
            <div class="accordion-item" data-reveal>
                <h2 class="accordion-header">
                    <button class="accordion-button @(i > 0 ? "collapsed" : "")" type="button" data-bs-toggle="collapse" data-bs-target="#faq@(i)">
                        @faqs[i].Q
                    </button>
                </h2>
                <div id="faq@(i)" class="accordion-collapse collapse @(i == 0 ? "show" : "")" data-bs-parent="#faq">
                    <div class="accordion-body">@faqs[i].A</div>
                </div>
            </div>
        }
    </div>

    <h2 class="h4" data-reveal>Fiyatlandırma</h2>
    <p class="text-muted">Fiyat, seçtiğiniz özelliklere göre otomatik hesaplanır ve ödeme öncesinde size satır satır gösterilir.</p>
    <table class="table" data-reveal>
        <tbody>
            <tr><td>Mektup (1 sayfa, zarf ve kayıtlı posta dahil)</td><td class="text-end">@M(Model.BasePrice)</td></tr>
            <tr><td>Her ek sayfa</td><td class="text-end">@M(Model.ExtraPage)</td></tr>
            <tr><td>Fotoğraf (adet başı, en fazla @Letter.MaxPhotos)</td><td class="text-end">@M(Model.Photo)</td></tr>
            <tr><td>Kartpostal</td><td class="text-end">@M(Model.Postcard)</td></tr>
            <tr><td>Renkli kağıt</td><td class="text-end">@M(Model.ColoredPaper)</td></tr>
            <tr><td>Renkli zarf</td><td class="text-end">@M(Model.ColoredEnvelope)</td></tr>
            <tr><td>Koku (manolya, lavanta, bahar çiçekleri)</td><td class="text-end">@M(Model.Scent)</td></tr>
            <tr><td>Mobil ödeme operatör farkı</td><td class="text-end">%@((Model.MobilePaymentSurchargeRate * 100).ToString("0"))</td></tr>
        </tbody>
    </table>
</div>
