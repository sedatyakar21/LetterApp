@model ResetPasswordViewModel
@using MektupApp.Domain.Customers
@{
    ViewData["Title"] = "SMS Kodu";
}
<div class="container py-4" style="max-width: 440px">
    <h1 class="h3 mb-4">Yeni şifre belirleyin</h1>
    <div class="card card-body">
        @if (ViewBag.Info is string info)
        {
            <div class="alert alert-info small">@info</div>
        }
        <form asp-action="Code" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger small"></div>
            <input type="hidden" asp-for="Email" />
            <div class="mb-3">
                <label asp-for="Code" class="form-label"></label>
                <input asp-for="Code" class="form-control form-control-lg text-center font-monospace" inputmode="numeric" pattern="[0-9 ]*"
                       maxlength="7" autocomplete="one-time-code" placeholder="______" autofocus required />
                <span asp-validation-for="Code" class="text-danger small"></span>
            </div>
            <partial name="_NewPasswordFields" />
            <button type="submit" class="btn btn-primary w-100">Şifremi Değiştir</button>
        </form>
        @* Kod gelmediyse aynı e-postayla yeniden iste (önceki kod geçersiz olur). *@
        <form asp-action="Forgot" method="post" class="mt-3 text-center">
            <input type="hidden" name="Email" value="@Model.Email" />
            <input type="hidden" name="Method" value="@PasswordResetMethod.Sms" />
            <button type="submit" class="btn btn-link btn-sm p-0">Kod gelmedi mi? Yeniden gönder</button>
        </form>
        <p class="text-center small mt-2 mb-0"><a asp-controller="Account" asp-action="Login">← Giriş sayfasına dön</a></p>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
