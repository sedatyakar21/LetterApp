@model TrackingResultDto?
@{
    ViewData["Title"] = "Gönderi Takibi";
}
<div class="container py-4" style="max-width: 640px">
    <h1 class="h3 mb-3">Gönderi Takibi</h1>
    <form method="get" class="d-flex gap-2 mb-4">
        <input name="code" value="@ViewBag.Code" class="form-control" placeholder="Takip kodu (ör. RR123456789TR)" required />
        <button class="btn btn-primary" type="submit">Sorgula</button>
    </form>

    @if (ViewBag.NotFound == true)
    {
        <div class="alert alert-warning">Bu takip koduna ait bir gönderi bulunamadı.</div>
    }
    else if (Model is not null)
    {
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <div class="fw-semibold">@Model.TrackingCode</div>
                        <div class="text-muted small">Alıcı: @Model.RecipientInitials · @Model.City</div>
                    </div>
                    <partial name="_StatusBadge" model="Model.Status" />
                </div>
                <ul class="timeline">
                    @foreach (var h in Model.History.Reverse())
                    {
                        <li>
                            <div class="fw-semibold small">@h.Status.DisplayName()</div>
                            <div class="small">@h.Note</div>
                            <div class="text-muted small">@h.At.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</div>
                        </li>
                    }
                </ul>
            </div>
        </div>
    }
</div>
