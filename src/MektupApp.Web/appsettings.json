{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Server=.;Database=MektupApp;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True"
  },
  "Storage": {
    "UploadsPath": "App_Data/uploads"
  },
  "Pricing": {
    "BasePrice": 290,
    "ExtraPage": 30,
    "Photo": 20,
    "Postcard": 35,
    "ColoredPaper": 15,
    "ColoredEnvelope": 15,
    "Scent": 40,
    "MobilePaymentSurchargeRate": 0.30
  },
  // Müşteri destek: WhatsApp numarası ülke koduyla (ör. 905321234567). Boşsa yardım butonu gösterilmez.
  "Support": {
    "WhatsAppNumber": "",
    "WhatsAppDisplay": null,
    "Hours": "Hafta içi 09:00–18:00",
    "Email": null
  },
  // Ödeme: "Simulation" (gerçek tahsilat yok) veya "PayTR".
  // MerchantKey / MerchantSalt'ı buraya yazmayın: user-secrets veya ortam değişkeni kullanın
  // (Payment__PayTR__MerchantId, Payment__PayTR__MerchantKey, Payment__PayTR__MerchantSalt).
  // PayTR Mağaza Paneli'nde Bildirim URL: https://<alan-adınız>/odeme/paytr/bildirim
  "Payment": {
    "Provider": "Simulation",
    "ExpireAfterMinutes": 45,
    "PayTR": {
      "BaseUrl": "https://www.paytr.com",
      "MerchantId": "",
      "MerchantKey": "",
      "MerchantSalt": "",
      "TestMode": true,
      "DebugOn": true,
      "NoInstallment": true,
      "MaxInstallment": 0,
      "TimeoutLimitMinutes": 30,
      "Currency": "TL",
      "Lang": "tr"
    }
  },
  // PTT web servis entegrasyonu. Enabled = false iken simülasyon kullanılır.
  // CustomerId / Password / TrackingPassword'u buraya yazmayın: user-secrets veya
  // ortam değişkeni kullanın (Ptt__CustomerId, Ptt__Password, Ptt__TrackingPassword).
  "Ptt": {
    "Enabled": false,
    "UseTestEnvironment": true,
    "BaseUrl": "https://pttws.ptt.gov.tr",
    "CustomerId": 0,
    "Username": "PttWs",
    "Password": "",
    "TrackingUsername": null,
    "TrackingPassword": null,
    "ShipmentType": "KARGO",
    "ShipmentKind": "NORMAL",
    "PaymentMethod": "MH",
    "ExtraService": null,
    "TimeoutSeconds": 30,
    "Barcode": {
      "Format": "S10",
      "Prefix": "RR",
      "Suffix": "TR",
      "RangeStart": 10000000,
      "RangeEnd": 19999999
    },
    "Sync": {
      "Enabled": true,
      "IntervalMinutes": 30,
      "MinRecheckMinutes": 60,
      "BatchSize": 50
    }
  }
}
